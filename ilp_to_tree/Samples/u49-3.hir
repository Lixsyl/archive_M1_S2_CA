/* String Litterals */
label L_str_0 "*"

/* Function Definitions */

/* Main */
# Routine main
label main
sxp
  call
    name concat
    call
      name string_of_float
      binop
      divF      
      constF 5.0      
      callF
        name float_of_int
        float        const 2        
      call end
      
    call end
    
  call end

