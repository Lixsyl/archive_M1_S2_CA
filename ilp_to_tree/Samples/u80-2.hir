/* == High Level Intermediate representation. == */
/* String Litterals */
label L_str_1 "0"
label L_str_0 "FUNCTION"

/* Function Definitions */
/* function : test */
# Routine: L1
label L1
  # Body
  move
  temp rv
  call
    name concat
    temp i0    call
      name string_of_int
      const 1      
    call end
    
  call end
  
  label end
  
  
  /* Main */
  # Routine main
  label main
  sxp
    eseq
      sxp
        call
          name print
          call
            name concat
            call
              name concat
              eseq
                seq
                  sxp
                    temp L1                    
                seq end
                name L_str_0                
                call
                  name string_of_int
                  call
                    name L1
                    const 2                    
                  call end
                  
                call end
                
              call end
              call
                name L1
                name L_str_1                
              call end
              
            call end
            
          call end
        const 0    
label end
