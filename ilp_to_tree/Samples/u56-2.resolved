function even(n)
(if (n ILP_Equal_INT 0)
    then true
    else 
        (if (n ILP_Equal_INT 1)
            then false
            else (odd((n ILP_Minus_INT 1)); true
                )
        )
);
function odd(n)
(if (n ILP_Equal_INT 0)
    then false
    else 
        (if (n ILP_Equal_INT 1)
            then true
            else even((n ILP_Minus_INT 1))
        )
);
(ILP_Notodd(56))
