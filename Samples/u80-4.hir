/* == High Level Intermediate representation. == */
/* String Litterals */
label L_str_4 "E"
label L_str_1 "BOOL"
label L_str_3 "false"
label L_str_2 "true"
label L_str_0 "GEORGE "

/* Function Definitions */

/* Main */
# Routine main
label main
sxp
  eseq
    sxp
      call
        name print
        call
          name concat
          eseq
            seq
              cjump
                ne
                eseq
                  seq
                    sxp
                      eseq
                        sxp
                          call
                            name print
                            name L_str_0                            
                          call end
                        const 0                      
                  seq end
                  name L_str_1                  
                  
                  const 0
                  name L2
                  name L3
                label L2
                move
                temp L1
                name L_str_2                
                jump name L4
                label L3
                move
                temp L1
                name L_str_3                
                label L4
              seq end
              temp L1
            
          call end
          
        call end
      const 0  
label end
