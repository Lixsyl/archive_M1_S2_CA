function even(n)
(if (n; 0; false
        )
    then true
    else 
        (if (n; 1; false
                )
            then false
            else (odd((n ILP_Minus_INT 1)); true
                )
        )
);
function odd(n)
(if (n; 0; false
        )
    then false
    else 
        (if (n; 1; false
                )
            then true
            else even((n ILP_Minus_INT 1))
        )
);
(ILP_Notodd(56))
