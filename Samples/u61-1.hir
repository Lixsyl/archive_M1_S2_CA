/* == High Level Intermediate representation. == */
/* String Litterals */
label L_str_0 "coucou"
label L_str_1 "STRING"

/* Function Definitions */

/* Main */
# Routine main
label main
sxp
  eseq
  seq
    move
    temp t1
    const 1    
  seq end
  eseq
    sxp
      call
        name print
        eseq
          seq
            cjump
              ne
              eseq
                seq
                  sxp
                    temp t1                    
                seq end
                const 1                
                
                const 0
                name L2
                name L3
              label L2
              move
              temp L1
              eseq
                seq
                  sxp
                    call
                      name concat
                      call
                        name string_of_int
                        temp t1                        
                      call end
                      
                    call end
                    
                seq end
                name L_str_1                
                
                jump name L4
                label L3
                move
                temp L1
                call
                  name string_of_float
                  constF 1.5                  
                call end
                
                label L4
              seq end
              temp L1
            
          call end
        const 0    
label end
