/* == High Level Intermediate representation. == */
/* String Litterals */
label L_str_1 "false"
label L_str_0 "true"

/* Function Definitions */

/* Main */
# Routine main
label main
sxp
  eseq
    sxp
      call
        name print
        eseq
          seq
            cjump
              ne
              eseq
                seq
                  sxp
                    const 4                    
                  sxp
                    const 5                    
                seq end
                const 0                
                
                const 0
                name L2
                name L3
              label L2
              move
              temp L1
              name L_str_0              
              jump name L4
              label L3
              move
              temp L1
              name L_str_1              
              label L4
            seq end
            temp L1
          
        call end
      const 0  
label end
