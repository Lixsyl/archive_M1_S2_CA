label L1
move temp rv binop add temp i0 temp i1 
label end
label main
seq
  cjump ne const 1 const 0 name L2 name L3 
  label L3
  move temp t1 const 1 
  label L2
  move temp t1 const 8 
  jump name L4 
  label L4
  move temp t3 temp t1 
  move temp t2 const 8 
  move temp t0 binop mul temp t2 temp t2 
  sxp
    call name L1 int temp t3 int temp t0 call end
seq end
label end
