label L_str_0
 "cou"
label L1
move temp rv binop add temp i0 temp i0 
label end
label L2
seq
  move temp t1 temp i0 
  move temp t0 temp i0 
  move temp rv call name concat int temp t1 int temp t0 call end 
seq end
label end
label main
seq
  move temp t3 call name L2 int name L_str_0 call end 
  sxp
    call name print int temp t3 call end
  sxp
    const 0
  move
    temp t2
    call name string_of_int int call name L1 int const 2 call end call end
    
  sxp
    call name print int temp t2 call end
  sxp
    const 0
seq end
label end
