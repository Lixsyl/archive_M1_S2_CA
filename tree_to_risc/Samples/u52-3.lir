label main
seq
  move temp t1 const 5 
  label L1
  cjump lt temp t1 const 42 name L4 name L5 
  label L5
  move temp t2 const 0 
  label L4
  move temp t2 const 1 
  jump name L6 x
  label L6
  cjump ne temp t2 const 0 name L2 name L3 
  label L3
  sxp
    const 0
  move temp t3 temp t1 
  move temp t0 call name string_of_int int temp t3 call end 
  sxp
    call name print int temp t0 call end
  sxp
