label main
seq
  cjump ne const 0 const 0 name L1 name L2 
  label L2
  sxp
    const 3
  move temp t1 const 1 
  jump name L3 
  label L1
  sxp
    const 3
  cjump ne const 1 const 0 name L4 name L5 
  label L5
  move temp t1 const 1 
  jump name L3 
  label L4
  move temp t1 const 0 
  jump name L3 
  label L3
  sxp
    temp t1
seq end
label end
