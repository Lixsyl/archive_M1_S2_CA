label L1
seq
  cjump eq temp i0 const 0 name L5 name L6 
  label L5
  move temp t2 const 1 
  jump name L7 x
  label L6
  move temp t2 const 0 
  label L7
  cjump ne temp t2 const 0 name L2 name L3 
  label L2
  move temp t1 const 1 
  jump name L4 x
  label L3
  move
    temp t1
    binop mul temp i0 eseq
                        seq
                          move temp t0 binop sub temp i0 const 1 
                        seq end
                        call name L1 int temp t0 call end
    
  label L4
  move temp rv temp t1 
seq end
label end
label main
seq
  move temp t3 const 5 
  sxp
    call name L1 int temp t3 call end
seq end
label end
